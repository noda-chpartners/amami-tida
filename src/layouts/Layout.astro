---
import "../styles/global.scss";
import "lenis/dist/lenis.css";
import SunMark from "../components/SunMark.astro";
import { buildJsonLd, restaurant } from "../data/site";

interface Props {
  title?: string;
  description?: string;
}

const { title = restaurant.title, description = restaurant.description } = Astro.props;

const { instagram, phoneHref } = restaurant;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const origin = Astro.site?.origin;
const ogImage = origin ? new URL("/ogp.jpg", origin).href : "/ogp.jpg";
const jsonLd = JSON.stringify(buildJsonLd(origin)).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#fff8f1" />
    <meta name="application-name" content="てぃだ" />
    <meta name="apple-mobile-web-app-title" content="てぃだ" />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {canonical && <link rel="sitemap" type="application/xml" href="/sitemap.xml" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content={restaurant.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={restaurant.ogImageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={restaurant.ogImageAlt} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Shippori+Mincho:wght@500;600;700&family=Zen+Kaku+Gothic+New:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      document.documentElement.classList.add("js");
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.documentElement.classList.add("will-animate");
      }
    </script>
    <script type="application/ld+json" is:inline set:html={jsonLd} />
  </head>
  <body>
    <a class="skip" href="#main">本文へスキップ</a>

    <header class="site-header">
      <div class="wrap site-header__inner">
        <a class="brand" href="#top">
          <SunMark class="brand__mark" />
          <span class="brand__text">
            <span class="brand__name">てぃだ</span>
            <span class="brand__en">Amami Island Food</span>
          </span>
        </a>

        <nav id="site-nav" class="site-nav" aria-label="主要">
          <a href="#story">てぃだ</a>
          <a href="#menu">料理</a>
          <a href="#course">コース</a>
          <a href="#access">案内</a>
          <a class="site-nav__phone" href={phoneHref}>06-6881-3639</a>
        </nav>

        <a class="btn btn--header" href={phoneHref}>
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
            <path
              fill="currentColor"
              d="M7.1 3.6h2.2l1.3 3.2-1.7 1.2a13 13 0 0 0 6.1 6.1l1.2-1.7 3.2 1.3v2.2c0 .8-.7 1.5-1.5 1.6A15.4 15.4 0 0 1 5.5 5.1c.1-.8.8-1.5 1.6-1.5Z"
            ></path>
          </svg>
          <span>06-6881-3639</span>
        </a>

        <button
          class="nav-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="site-nav"
        >
          <span class="nav-toggle__bars" aria-hidden="true"></span>
          <span class="sr-only">メニュー</span>
        </button>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap site-footer__inner">
        <div class="site-footer__brand">
          <p class="site-footer__name">奄美島料理てぃだ</p>
          <p class="site-footer__en">Amami Island Food</p>
        </div>
        <address class="site-footer__address">
          〒{restaurant.postalCode} {restaurant.region}{restaurant.locality}{restaurant.streetAddress}<br />
          <a href={phoneHref}>{restaurant.phoneDisplay}</a><br />
          18:00〜23:00 / 月・火定休
        </address>
        <a class="site-footer__sns" href={instagram} target="_blank" rel="noopener noreferrer">
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
            <rect x="4" y="4" width="16" height="16" rx="4" fill="none" stroke="currentColor" stroke-width="1.6"></rect>
            <circle cx="12" cy="12" r="3.4" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
            <circle cx="16.6" cy="7.4" r="0.8" fill="currentColor"></circle>
          </svg>
          <span>Instagram</span>
        </a>
      </div>
      <p class="wrap site-footer__copy">© {new Date().getFullYear()} {restaurant.name}</p>
    </footer>

    <div class="dock">
      <a href={phoneHref}>電話する</a>
      <a href="#access">店舗案内</a>
    </div>

    <script>
      import { initMotion } from "../scripts/motion";
      initMotion();
    </script>
  </body>
</html>
