---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import TideWave from "../components/TideWave.astro";
import { siInstagram, siTabelog } from "simple-icons";
import { course, dishes, restaurant } from "../data/site";
import somenCut from "../assets/images/aburaso-men.jpg";
import keihanImage from "../assets/images/keihan.png";
import roastImage from "../assets/images/roast.png";
import umibudoImage from "../assets/images/umibudo-ebi.png";
import goyaImage from "../assets/images/goya.png";
import kakuniImage from "../assets/images/kakuni-plate.png";
import courseImage from "../assets/images/ko-su.jpg";
import exteriorImage from "../assets/images/exterior.png";
import interiorImage from "../assets/images/てぃだ_内観_木目テーブル.jpg";
import liveImage from "../assets/images/live-wide.jpg";

const somen = dishes.find((dish) => dish.name === "油ソーメン")!;
const keihan = dishes.find((dish) => dish.name === "鶏飯")!;
const umibudo = dishes.find((dish) => dish.name === "海ぶどう")!;
const goya = dishes.find((dish) => dish.name === "ニガウリ豆腐炒め")!;
const kakuni = dishes.find((dish) => dish.name === "自家製皮付き豚の角煮")!;
const courseTitle = course.name.split(" ");

const { phoneHref, tabelog, groupForm, mapHref, instagram } = restaurant;
---

<Layout>
  <section class="cover" id="top">
    <Image
      src={liveImage}
      alt="島唄の夜、席で手を挙げるお客さま"
      widths={[1200, 1800, 2400]}
      sizes="100vw"
      quality={76}
      loading="eager"
      fetchpriority="high"
      class="cover__photo"
    />
    <div class="cover__copy">
      <h1 class="cover__title">
        <span class="cover__bold hero__line">島の夕餉を、</span>
        <span class="cover__light hero__line">天神橋で。</span>
      </h1>
      <p class="cover__lead hero__lead">島のごはんと、にぎやかな夜。</p>
    </div>
    <a class="cover__reserve hero__actions" href={tabelog} target="_blank" rel="noopener noreferrer">ご予約</a>
  </section>
  <TideWave />

  <section class="about" id="story">
    <div class="about__copy">
      <h2>ここは大阪、<br />気分は奄美。</h2>
      <p class="about__lead">島のごはんと、にぎやかな夜。<br />天神橋の二階で、お待ちしています。</p>
      <p class="about__text">鶏飯や油ソーメンなど、島の皿を揃えています。<br />徳之島から届く豚肉のコースも、ご用意しています。</p>
    </div>
    <figure class="about__photo">
      <Image
        src={interiorImage}
        alt="木のテーブルが並ぶ、てぃだの二階"
        widths={[640, 1000, 1400]}
        sizes="(min-width: 900px) 48vw, 100vw"
        quality={76}
      />
    </figure>
  </section>

  <section class="dish dish--somen" id="plates">
    <div class="dish__copy">
      <p class="dish__no">01</p>
      <div class="dish__head">
        <h2>{somen.name}</h2>
        <p class="dish__price">{somen.price}<span>円</span></p>
      </div>
      <p class="dish__text">細麺に野菜と肉を絡めて炒めた、<br />てぃだで名前のあがる一皿です。</p>
    </div>
    <figure class="dish__photo">
      <Image
        src={somenCut}
        alt="木の器に盛った油ソーメン"
        widths={[900, 1400, 1800]}
        sizes="(min-width: 900px) 46vw, 86vw"
        quality={82}
        class="drift"
      />
    </figure>
  </section>

  <section class="dish dish--keihan">
    <figure class="dish__photo">
      <Image
        src={keihanImage}
        alt="ご飯と具材、だしを分けて出した鶏飯"
        widths={[800, 1200]}
        sizes="(min-width: 900px) 42vw, 86vw"
        quality={82}
        class="drift"
      />
    </figure>
    <div class="dish__copy">
      <p class="dish__no">02</p>
      <div class="dish__head">
        <h2>{keihan.name}</h2>
        <p class="dish__price">{keihan.price}<span>円</span></p>
      </div>
      <p class="dish__text">鶏、錦糸卵、椎茸、ねぎ、紅生姜。<br />温かいだしをかけていただきます。</p>
    </div>
  </section>

  <section class="dish dish--roast">
    <div class="dish__copy">
      <p class="dish__no">03</p>
      <div class="dish__head">
        <h2>徳之島産豚の<br />炙りローストポーク</h2>
      </div>
      <p class="dish__text">徳之島から直送した豚肉を、炙って一皿に。<br />コースの中の一品です。</p>
    </div>
    <figure class="dish__photo">
      <Image
        src={roastImage}
        alt="徳之島産豚の炙りローストポーク"
        widths={[900, 1400, 1800]}
        sizes="(min-width: 900px) 70vw, 86vw"
        quality={80}
        class="drift"
      />
    </figure>
  </section>

  <section class="scatter" aria-label="そのほかの皿">
    <article class="dish">
      <div class="dish__copy">
        <p class="dish__no">04</p>
        <div class="dish__head">
          <h3>{umibudo.name}</h3>
          <p class="dish__price">{umibudo.price}<span>円</span></p>
        </div>
        <p class="dish__text">プチプチとはじける食感。<br />島の海から届く一皿です。</p>
      </div>
      <figure class="dish__photo">
        <Image src={umibudoImage} alt="海ぶどう" widths={[640, 1000]} sizes="(min-width: 900px) 48vw, 80vw" quality={78} class="drift" />
      </figure>
    </article>
    <article class="dish">
      <div class="dish__copy">
        <p class="dish__no">05</p>
        <div class="dish__head">
          <h3>{goya.name}{"alias" in goya && <span>{goya.alias}</span>}</h3>
          <p class="dish__price">{goya.price}<span>円</span></p>
        </div>
        <p class="dish__text">苦みのあるニガウリに、<br />豆腐と卵を合わせた炒め物です。</p>
      </div>
      <figure class="dish__photo">
        <Image src={goyaImage} alt="ニガウリ豆腐炒め" widths={[640, 1000]} sizes="(min-width: 900px) 36vw, 80vw" quality={78} class="drift" />
      </figure>
    </article>
    <article class="dish">
      <div class="dish__copy">
        <p class="dish__no">06</p>
        <div class="dish__head">
          <h3>{kakuni.name}</h3>
          <p class="dish__price">{kakuni.price}<span>円</span></p>
        </div>
        <p class="dish__text">皮を残した豚肉を、<br />時間をかけて煮込んでいます。</p>
      </div>
      <figure class="dish__photo">
        <Image src={kakuniImage} alt="自家製皮付き豚の角煮" widths={[640, 1000]} sizes="(min-width: 900px) 40vw, 80vw" quality={78} class="drift" />
      </figure>
    </article>
  </section>

  <section class="course" id="course">
    <figure class="course__frame">
      <Image
        src={courseImage}
        alt="徳之島ずくし豚しゃぶコース。しゃぶしゃぶと前菜が並ぶ卓"
        widths={[800, 1200, 1600]}
        sizes="(min-width: 900px) 48vw, 86vw"
        quality={78}
        class="course__photo"
      />
    </figure>
    <div class="course__copy">
      <p class="course__price">{course.priceLabel}</p>
      <p class="course__note">{course.priceNote}</p>
      <div class="course__wave" aria-hidden="true"></div>
      <div class="course__sheet">
        <h2>{courseTitle[0]}<br class="course__break" />{courseTitle.slice(1).join(" ")}</h2>
        <ul>
          {course.items.map((item) => <li>{item}</li>)}
        </ul>
        <a class="act" href={groupForm} target="_blank" rel="noopener noreferrer">
          <svg class="act__icon" viewBox="0 0 24 24" aria-hidden="true">
            <path fill="currentColor" d="M19 4h-1V2h-2v2H8V2H6v2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 16H5V10h14v10zm0-12H5V6h14v2z"></path>
          </svg>
          大人数・貸切のご相談はこちら
        </a>
      </div>
    </div>
  </section>

  <section class="night" id="night">
    <Image
      src={interiorImage}
      alt="木のテーブルが並ぶ、てぃだの店内"
      widths={[1000, 1600, 2000]}
      sizes="100vw"
      quality={76}
      class="night__photo"
    />
    <p class="night__line">島唄が、夜をつなぐ。</p>
    <p class="night__text">島の音と、みんなの笑顔で、てぃだの夜はもっとにぎやかに。ライブ開催日は店舗へお問い合わせください。</p>
    <a class="act night__ig" href={instagram} target="_blank" rel="noopener noreferrer">
      <svg class="act__icon" viewBox="0 0 24 24" aria-hidden="true">
        <path fill="currentColor" d={siInstagram.path}></path>
      </svg>
      Instagram
    </a>
  </section>

  <section class="visit" id="access">
    <Image
      src={exteriorImage}
      alt="夜の天神橋筋に灯る、奄美島料理てぃだの入口"
      widths={[900, 1400, 1800]}
      sizes="100vw"
      quality={78}
      class="visit__photo"
    />
    <figure class="visit__inset">
      <Image
        src={interiorImage}
        alt="木のテーブルが並ぶ、てぃだの店内"
        widths={[360, 640]}
        sizes="220px"
        quality={76}
      />
    </figure>
    <div class="visit__panel">
      <div class="visit__facts">
        <p class="visit__name">奄美島料理　てぃだ</p>
        <p>{restaurant.locality}{restaurant.streetAddress}</p>
        <p>18:00–23:00<span>月・火 定休</span></p>
        <a class="act act--map" href={mapHref} target="_blank" rel="noopener noreferrer">
          <svg class="act__pin" viewBox="0 0 24 24" aria-hidden="true">
            <path fill="currentColor" d="M12 2.2c-4 0-7.2 3.2-7.2 7.2 0 5.3 7.2 12.4 7.2 12.4s7.2-7.1 7.2-12.4c0-4-3.2-7.2-7.2-7.2zm0 9.8a2.6 2.6 0 1 1 0-5.2 2.6 2.6 0 0 1 0 5.2z"></path>
          </svg>
          Googleマップで見る
        </a>
      </div>
      <div class="visit__close" id="reserve">
        <a class="visit__phone" href={phoneHref}>{restaurant.phoneDisplay}</a>
        <ul class="visit__actions">
          <li>
            <a class="act" href={phoneHref}>
              <svg class="act__icon" viewBox="0 0 24 24" aria-hidden="true">
                <path fill="currentColor" d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.01-.24 11.4 11.4 0 0 0 3.58.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.46.57 3.58a1 1 0 0 1-.25 1.01l-2.2 2.2z"></path>
              </svg>
              電話で予約
            </a>
          </li>
          <li>
            <a class="act act--fill" href={tabelog} target="_blank" rel="noopener noreferrer">
              <svg class="act__icon" viewBox="0 0 24 24" aria-hidden="true">
                <path fill="currentColor" d={siTabelog.path}></path>
              </svg>
              食べログで予約
            </a>
          </li>
          <li>
            <a class="act" href={groupForm} target="_blank" rel="noopener noreferrer">
              <svg class="act__icon" viewBox="0 0 24 24" aria-hidden="true">
                <path fill="currentColor" d="M19 4h-1V2h-2v2H8V2H6v2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 16H5V10h14v10zm0-12H5V6h14v2z"></path>
              </svg>
              大人数・貸切のご相談はこちら
            </a>
          </li>
        </ul>
      </div>
    </div>
  </section>
</Layout>
