---
import { Image } from "astro:assets";
import "../styles/global.scss";
import "../styles/paper.scss";
import "lenis/dist/lenis.css";
import logo from "../assets/images/logo.png";
import { siInstagram } from "simple-icons";
import { buildJsonLd, restaurant } from "../data/site";

interface Props {
  title?: string;
  description?: string;
}

const { title = restaurant.title, description = restaurant.description } = Astro.props;

const { instagram, phoneHref, tabelog } = restaurant;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const origin = Astro.site?.origin;
const ogImage = origin ? new URL("/ogp.jpg", origin).href : "/ogp.jpg";
const jsonLd = JSON.stringify(buildJsonLd(origin)).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#faf6f0" />
    <meta name="application-name" content="てぃだ" />
    <meta name="apple-mobile-web-app-title" content="てぃだ" />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {canonical && <link rel="sitemap" type="application/xml" href="/sitemap.xml" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content={restaurant.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={restaurant.ogImageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={restaurant.ogImageAlt} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Shippori+Mincho:wght@500;600;700&family=Zen+Kaku+Gothic+New:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      document.documentElement.classList.add("js");
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.documentElement.classList.add("will-animate");
      }
    </script>
    <script type="application/ld+json" is:inline set:html={jsonLd} />
  </head>
  <body>
    <a class="skip" href="#main">本文へスキップ</a>

    <header class="site-header">
      <div class="wrap site-header__inner">
        <a class="brand" href="#top" aria-label="奄美島料理てぃだ">
          <Image
            src={logo}
            alt="奄美島料理てぃだ"
            class="brand__logo"
            widths={[320, 480, 720]}
            sizes="172px"
            quality={90}
            loading="eager"
          />
        </a>

        <nav id="site-nav" class="site-nav" aria-label="主要">
          <a href="#plates">三つの皿</a>
          <a href="#night">夜の席</a>
          <a class="site-nav__reserve" href={tabelog} target="_blank" rel="noopener noreferrer">ご予約</a>
          <a class="site-nav__phone" href={phoneHref}>06-6881-3639</a>
        </nav>

        <button
          class="nav-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="site-nav"
        >
          <span class="nav-toggle__bars" aria-hidden="true"></span>
          <span class="sr-only">メニュー</span>
        </button>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap site-footer__line">
        <a class="site-footer__ig" href={instagram} target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path fill="currentColor" d={siInstagram.path}></path>
          </svg>
          Instagram
        </a>
        <p>© {new Date().getFullYear()} {restaurant.name}</p>
      </div>
    </footer>

    <div class="dock">
      <a href={phoneHref}>電話する</a>
      <a href={tabelog} target="_blank" rel="noopener noreferrer">食べログで予約</a>
    </div>

    <script>
      import { initMotion } from "../scripts/motion";
      initMotion();
    </script>
  </body>
</html>
